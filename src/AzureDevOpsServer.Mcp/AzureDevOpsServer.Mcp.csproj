<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AzureDevOpsServer.Mcp</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer;DotnetTool</PackageType>
    <ToolCommandName>azure-devops-server-mcp</ToolCommandName>
    <PackageId>AzureDevOpsServer.Mcp</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <Description>MCP server for Azure DevOps Server (on-premises) with PAT authentication.</Description>
    <PackageTags>mcp;mcp-server;azure-devops;azure-devops-server;on-premises;pat</PackageTags>
    <RepositoryUrl>https://github.com/eXoz00rd/AzureMCP</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AzureDevOpsServer.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <McpManifestSource>$(MSBuildProjectDirectory)/.mcp/server.json</McpManifestSource>
    <McpManifestVersionToken>0.0.0-managed-by-build</McpManifestVersionToken>
  </PropertyGroup>

  <!-- The checked-in manifest carries a placeholder version. The packed copy is generated from
       PackageVersion so the package and its manifest can never disagree. -->
  <Target Name="GenerateMcpManifest" BeforeTargets="Build;_GetPackageFiles">
    <PropertyGroup>
      <!-- IntermediateOutputPath is only set once the SDK targets are imported, so it cannot be
           resolved in a file-level PropertyGroup. -->
      <McpManifestGenerated>$(IntermediateOutputPath)mcp/server.json</McpManifestGenerated>
      <_McpManifestRaw>$([System.IO.File]::ReadAllText('$(McpManifestSource)'))</_McpManifestRaw>
      <_McpManifestContent>$(_McpManifestRaw.Replace('$(McpManifestVersionToken)', '$(PackageVersion)'))</_McpManifestContent>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)mcp" />
    <WriteLinesToFile File="$(McpManifestGenerated)" Lines="$(_McpManifestContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(McpManifestGenerated)" Pack="true" PackagePath=".mcp/" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

</Project>